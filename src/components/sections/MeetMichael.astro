---
import { Image } from "astro:assets";
import { FACTS } from "../../data/facts";
import michaelPortrait from "../../assets/brand/michael-schlager-portrait.webp";
---

<!-- ===== 13. MEET MICHAEL ===== -->
<section class="sec sec--soft" id="michael">
  <div class="wrap">
    <div class="michael">
      <figure class="portrait rv" style="margin:0">
        <Image
          src={michaelPortrait}
          alt="Michael Schlager, founder of Hiring Solutions Group, at his desk."
          widths={[433, 866]}
          sizes="(max-width: 820px) 340px, 433px"
        />
      </figure>

      <div class="michael-copy rv" style="--d:1">
        <p class="eyebrow is-brand">About</p>
        <h2>Meet Michael Schlager</h2>
        <p class="michael-theme">Three Generations of Matchmakers.</p>
        <p class="lede">Michael Schlager grew up around people who understood that the right match can change a business, a career, or even a life.</p>
        <p class="lede">For three decades, he has applied that mindset to executive recruiting, interviewing, assessment, career strategy, and the decisions that connect companies with the people who can help them move forward.</p>
        <p class="lede">His approach is simple: listen carefully, understand deeply, and take the time required to make a better decision.</p>
        <ul class="proofs">
          <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{FACTS.yearsSentence}</span></li>
          <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Recruiting and HR training and credentials</li>
          <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Executive interviewing expertise</li>
          <li><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Long-term employer and professional relationships</li>
        </ul>
        <a class="btn btn--ghost" href="#">Meet Michael</a>
      </div>
    </div>
  </div>
</section>