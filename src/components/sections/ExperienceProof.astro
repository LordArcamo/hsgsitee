---
import { FACTS } from "../../data/facts";
---

<!-- ===== 10. EXPERIENCE & PROOF ===== -->
<section class="sec">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-brand">Experience &amp; Proof</p>
      <h2>Three Decades of Connecting People and Opportunity.</h2>
    </div>

    <dl class="stats">
      <div class="stat rv" style="--d:1"><dt>{FACTS.years}</dt><dd>Years of executive recruiting experience</dd></div>
      <div class="stat rv" style="--d:2"><dt>{FACTS.placements}</dt><dd>Placements</dd></div>
      <div class="stat rv" style="--d:3"><dt>{FACTS.network}</dt><dd>Professional / partner network</dd></div>
      <div class="stat rv" style="--d:4"><dt>{FACTS.resumes}</dt><dd>Resumes directly accessible</dd></div>
    </dl>

    <p class="stats-note rv">
      <span>Example social proof only — layout demonstration, not final content:</span>
      <span class="tag">LinkedIn recommendations</span>
      <span class="tag">Google reviews</span>
      <span class="tag">Ratings</span>
      <span class="tag">Testimonials</span>
    </p>
    <p class="legal legal--note rv">
      <span class="lbl">Internal note</span>
      The social-proof content shown in this design is example content demonstrating the intended layout. Final review counts, ratings, testimonials, statistics, and supporting claims must be verified before publication.
    </p>
  </div>
</section>