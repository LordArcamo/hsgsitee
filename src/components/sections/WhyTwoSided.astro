---
/*
 * The two-sided diagram: one side's considerations, HSG in the middle, the
 * other side's considerations. The homepage frames it as Employers and
 * Professionals; the Hiring Solutions page as The Company and The Candidate,
 * with its own lists and a closing line on representation. Defaults are the
 * homepage's.
 */
interface Side {
  label: string;
  items: string[];
}
interface Props {
  id?: string;
  soft?: boolean;
  eyebrow?: string;
  title?: string;
  ledes?: string[];
  left?: Side;
  right?: Side;
  outcome?: string;
  /** A closing statement under the diagram — used for the representation rule. */
  note?: string;
}

const {
  id,
  soft = false,
  eyebrow = "Why the Two-Sided Experience Matters",
  title = "Better Decisions Come From Understanding Both Perspectives.",
  ledes = [
    "Companies are looking for more than qualifications. Professionals are looking for more than a job. The strongest outcomes happen when business needs, capabilities, goals, culture, expectations, timing, and opportunity align.",
    "Because HSG has deep experience working with employers and professionals, we understand the questions, concerns, pressures, and expectations that can exist on either side. We use that perspective solely to serve the client we represent in each engagement.",
  ],
  left = {
    label: "Employers",
    items: ["Business Needs", "Role", "Cultural Fit", "Team Fit", "Leadership", "Performance"],
  },
  right = {
    label: "Professionals",
    items: ["Experience", "Personality", "Goals", "Values", "Timing", "Opportunity"],
  },
  outcome = "The Right Fit",
  note,
} = Astro.props;

const aria = `${left.label} considerations and ${right.label.toLowerCase()} considerations both meet at Hiring Solutions Group, producing ${outcome.toLowerCase()}.`;
---

<!-- ===== 3. WHY THE TWO-SIDED MODEL MATTERS ===== -->
<section class:list={["sec", { "sec--soft": soft }]} id={id}>
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-brand">{eyebrow}</p>
      <h2>{title}</h2>
      {ledes.map((l) => <p class="lede">{l}</p>)}
    </div>

    <div class="model" role="img" aria-label={aria}>
      <div class="model-col model-col--hire rv" style="--d:1">
        <p class="col-label">{left.label}</p>
        {left.items.map((it) => <div class="model-item">{it}</div>)}
      </div>

      <div class="model-hub rv" style="--d:2">
        <div class="hub-node">HSG</div>
        <div class="hub-stem" aria-hidden="true"></div>
        <div class="hub-out">{outcome}</div>
      </div>

      <div class="model-col model-col--career rv" style="--d:3">
        <p class="col-label">{right.label}</p>
        {right.items.map((it) => <div class="model-item">{it}</div>)}
      </div>
    </div>

    {note && <p class="model-note rv" style="--d:4">{note}</p>}
  </div>
</section>
