---
import { FEATURED_STORY as s } from "../../data/stories";
import { sup } from "../../lib/text";
---

<!-- ===== 12. FEATURED SUCCESS STORY =====
     The Hiring Solutions page tells the same story as Challenge / Approach /
     Outcome (hiring/ClientSuccess.astro); both read src/data/stories.ts. -->
<section class="sec" id="story">
  <div class="wrap">
    <div class="sec-head rv" style="margin-bottom:clamp(30px,3.6vw,46px)">
      <p class="eyebrow is-brand">Featured Success Story</p>
      <h2>{s.title}</h2>
    </div>

    <div class="story-grid">
      <div class="story-vis rv" style="--d:1">
        {s.metrics.map((m) => (
          <Fragment>
            <div class="story-metric">
              <b>{m.value}</b>
              <span>{m.label}</span>
            </div>
            <div class="story-divider"></div>
          </Fragment>
        ))}
        <div class="story-tags">
          {s.tags.map((t) => <span class="story-tag" set:html={sup(t)} />)}
        </div>
      </div>

      <div class="story-copy rv" style="--d:2">
        {[...s.challenge, ...s.approach].map((p) => <p>{p}</p>)}
        <p class="turn">{s.turn}</p>
        {s.outcome.map((p) => <p>{p}</p>)}
        <a class="btn" href="#">Read the Full Story <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
