---
/*
 * The complete spreadsheet. Same six professionals as the cards above and
 * the quick panel beside them, from the same `group.candidates`, rendered
 * through FULL_STATS — current role, the four card statistics, and the
 * software column that makes the six tell themselves apart at a glance.
 *
 * It stays on the page whatever the quick panel does: the panel links here,
 * it does not replace this.
 *
 * The scroll container is focusable so the table can be scrolled from the
 * keyboard on narrow screens; its text is never shrunk to make it fit.
 */
import { FULL_STATS, header } from "../../data/situations";
import type { Professional } from "../../data/role-groups";

interface Props {
  candidates: Professional[];
}

const { candidates } = Astro.props;
---

<section class="sec" id="full-comparison">
  <div class="wrap">
    <div class="sec-head rv">
      <h2>Compare the Professionals</h2>
    </div>

    <div
      class="sw-table-wrap rv"
      style="--d:1"
      tabindex="0"
      role="region"
      aria-label="Full comparison of the matching professionals"
    >
      <table class="sw-table">
        <thead>
          <tr>
            <th scope="col">Professional</th>
            {
              FULL_STATS.map((s) => (
                <th scope="col" class:list={[{ "is-num": s.numeric }]}>
                  {header(s)}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody data-sw-order>
          {
            candidates.map((p) => (
              <tr data-sw-id={p.id}>
                <th scope="row">{p.name}</th>
                {FULL_STATS.map((s) => (
                  <td class:list={[{ "is-num": s.numeric }]}>{s.value(p)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
