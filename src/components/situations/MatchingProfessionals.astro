---
/*
 * Six profile cards on the left, the quick comparison panel on the right.
 *
 * Every candidate on this page comes from `group.candidates` — the pool
 * belonging to the role group the employer chose, and nothing else. The
 * cards, the quick panel and the full table below are all handed that same
 * array, so the three can never disagree about who is on the page.
 *
 * Each card runs the summary and the statistics side by side rather than
 * stacking them, which is what keeps six candidates from pushing the
 * comparison far down the page — Michael's main note on v1.
 *
 * Every card carries the same four statistics in the same order because
 * both the labels and the order come from STATS, the one definition the
 * quick panel and the full table also read from.
 */
import { STATS } from "../../data/situations";
import type { RoleGroup, Professional } from "../../data/role-groups";
import QuickCompare from "./QuickCompare.astro";

interface Props {
  /** Only for the heading — who is shown comes from `candidates`. */
  group: RoleGroup;
  candidates: Professional[];
}

const { group, candidates } = Astro.props;
---

<section class="sec sec--soft sw-results" id="professionals">
  <div class="wrap">
    <div class="sec-head rv">
      <h2>
        {candidates.length}
        <span data-sw-title>{group.resultTitle}</span> Matching Your Search
      </h2>
    </div>

    <div class="sw-layout">
      <QuickCompare candidates={candidates} />

      <!-- data-sw-order marks a list the ranking re-orders; every child
           carries the id that identifies it across all three renderings.
           The two figures ranking reads are here too, so the browser can
           rank the rendered six without being sent the whole dataset. -->
      <div class="sw-cards" data-sw-order>
        {
          candidates.map((p, i) => (
            <article
              class="sw-card rv"
              style={`--d:${Math.min(i, 2)}`}
              data-sw-id={p.id}
              data-sw-exp={p.totalExperience}
              data-sw-salary={p.currentSalary}
            >
              <div class="sw-card-main">
                <header class="sw-card-head">
                  <span class="sw-mono" aria-hidden="true">
                    {p.name.charAt(0)}
                  </span>
                  <div class="sw-card-id">
                    <h3>{p.name}</h3>
                    <p class="sw-role">{p.role}</p>
                  </div>
                </header>

                <p class="sw-sum">{p.summary}</p>

                <ul class="sw-tools" aria-label={`Software and tools used by ${p.name}`}>
                  {p.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </div>

              <dl class="sw-stats">
                {STATS.map((s) => (
                  <div class:list={["sw-stat", { "sw-stat--wide": !s.numeric }]}>
                    <dt>{s.label}</dt>
                    <dd>{s.value(p)}</dd>
                  </div>
                ))}
              </dl>
            </article>
          ))
        }
      </div>
    </div>

    <p class="sw-fine rv">
      Candidate profiles shown are fictional examples created to demonstrate the
      HSG Situations Wanted experience.
    </p>
  </div>
</section>
