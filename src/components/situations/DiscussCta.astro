---
/*
 * Closing CTA. Sits on the --panel surface, like the homepage's final CTA,
 * so the results page ends on the same note the rest of the site does.
 */
import { url } from "../../lib/url";
---

<section class="sec sec--tight" id="discuss">
  <div class="wrap">
    <div class="sw-cta rv">
      <div class="sw-cta-copy">
        <h2>Interested in One or More of These Professionals?</h2>
        <p>
          HSG can help you evaluate fit, understand availability, and determine
          the next step.
        </p>
      </div>
      <a class="btn" href={`${url("/")}#close`}>
        Discuss These Professionals With HSG
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
