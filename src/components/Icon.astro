---
/*
 * Line icons for the Hiring Solutions cards, drawn to match the stroke
 * weight of the homepage's capability icons. Decorative: every card carries
 * its meaning in its heading, so the SVG is hidden from assistive tech.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;

const PATHS: Record<string, string> = {
  /* Two bubbles, tails on opposite sides — Michael asked specifically for an
     ongoing back-and-forth between two people, not one person presenting at
     another, which is what the single 'talk' bubble showed. */
  dialogue: '<path d="M4.5 4h7a2 2 0 0 1 2 2v2.2a2 2 0 0 1-2 2H8.2l-3.2 2.6v-2.6h-.5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M19.5 12.4h-7a2 2 0 0 0-2 2v2.2a2 2 0 0 0 2 2h3.3l3.2 2.6v-2.6h.5a2 2 0 0 0 2-2v-2.2a2 2 0 0 0-2-2z"/>',
  /* Someone joining, for onboarding. The old 'flag' read as a finish line. */
  "user-plus": '<circle cx="9.5" cy="8" r="3.6"/><path d="M2.6 20c0-3.5 3-5.8 6.9-5.8 1.1 0 2.1.2 3 .5"/><path d="M17.5 14.5v6M14.5 17.5h6"/>',
  graduation: '<path d="M12 4 2.6 8.3 12 12.6l9.4-4.3z"/><path d="M6.6 10.3V15c0 1.7 2.4 3 5.4 3s5.4-1.3 5.4-3v-4.7"/><path d="M21.4 8.3v5.2"/>',
  /* Weighing terms. A handshake was drawn three ways and read as a squiggle
     every time; a balance is unambiguous at 22px. */
  scale: '<path d="M12 4.5v15M8.5 19.5h7"/><path d="M4 8.2h16"/><path d="M4 8.2 1.8 13.4a2.6 2.6 0 0 0 4.4 0z"/><path d="M20 8.2l-2.2 5.2a2.6 2.6 0 0 0 4.4 0z"/>',
  /* The actual job, for real-world evaluation. A hard hat kept reading as a
     serving cloche; a toolkit does not. */
  toolkit: '<rect x="2.6" y="8.4" width="18.8" height="11" rx="2"/><path d="M8.6 8.4V6.6a1.8 1.8 0 0 1 1.8-1.8h3.2a1.8 1.8 0 0 1 1.8 1.8v1.8"/><path d="M2.6 13.2h18.8"/><path d="M10 13.2v2.4h4v-2.4"/>',
  "video-call": '<rect x="2.5" y="5" width="14" height="14" rx="2.4"/><circle cx="9.5" cy="10.5" r="2.1"/><path d="M5.8 16.4c.5-1.7 2-2.6 3.7-2.6s3.2.9 3.7 2.6"/><path d="M16.5 10.8 21.5 8v8l-5-2.8z"/>',
  profile: '<rect x="2.6" y="4.4" width="18.8" height="15.2" rx="2.4"/><circle cx="8.4" cy="10.4" r="2.2"/><path d="M5 16.2c.5-1.6 1.9-2.4 3.4-2.4s2.9.8 3.4 2.4"/><path d="M14.6 9.6h4.2M14.6 12.6h4.2M14.6 15.6h2.6"/>',
  /* Someone experienced beside someone earlier on. */
  mentor: '<circle cx="8" cy="7.6" r="3.2"/><path d="M2.4 19.4c0-3.1 2.5-5 5.6-5 1 0 2 .2 2.8.6"/><circle cx="17.4" cy="12.4" r="2.4"/><path d="M13.2 19.4c0-2.3 1.9-3.8 4.2-3.8s4.2 1.5 4.2 3.8"/>',

  play: "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M10.2 8.6l5.2 3.4-5.2 3.4z\"/>",
  user: "<circle cx=\"12\" cy=\"8\" r=\"3.6\"/><path d=\"M4.5 20c0-3.6 3.2-6 7.5-6s7.5 2.4 7.5 6\"/>",
  search: "<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.7-3.7\"/>",
  calendar: "<rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"2.5\"/><path d=\"M3.5 10h17M8 3v4M16 3v4\"/>",
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.3"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M9 13.5l2 2 4-4"/>',
  network: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M12 7.2v4.3M12 11.5l-5.4 4.9M12 11.5l5.4 4.9"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7.5a4 4 0 0 1 8 0V11"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  sprout: '<path d="M12 21V11"/><path d="M12 11c0-4 3-6 7-6 0 4-3 6-7 6z"/><path d="M12 14c0-3-2.5-5-6-5 0 3 2.5 5 6 5z"/>',
  building: '<path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-5h6v5"/><path d="M9 10h.01M15 10h.01"/>',
  talk: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
  flag: '<path d="M5 21V4"/><path d="M5 4h11l-2 4 2 4H5"/>',
  people: '<circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3 2.5-5 5-5s5 2 5 5"/><path d="M14 20c0-2.5 1.5-4 3-4s3 1.5 3 4"/>',
  code: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>',
  window: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18"/><path d="M8 21h8M12 18v3"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.4 4 5.6 4 9s-1.4 6.6-4 9c-2.6-2.4-4-5.6-4-9s1.4-6.6 4-9Z"/>',
  chart: '<path d="M4 19V9M9.5 19V5M15 19v-7M20.5 19v-4"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7"/><path d="M3 12h18"/>',
  heart: '<path d="M12 20s-7-4.4-7-9.2A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.8C19 15.6 12 20 12 20Z"/>',
  star: '<path d="M12 4.5l2.3 4.7 5.2.8-3.8 3.6.9 5.1-4.6-2.4-4.6 2.4.9-5.1L4.5 10l5.2-.8L12 4.5Z"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2Z"/>',
  resume: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
};
const body = PATHS[name] ?? PATHS.target;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
/>
