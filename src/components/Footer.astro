---
import { SITE } from "../data/site";
import { url } from "../lib/url";
import Logo from "./Logo.astro";

interface Props {
  /**
   * Prefix for the in-page anchors — empty on the homepage, "/" elsewhere.
   * See components/Header.astro.
   */
  home?: string;
}

const { home = "" } = Astro.props;
---

<footer class="ftr">
  <div class="wrap ftr-in">
    <div class="ftr-top">
      <div class="ftr-brand">
        <a class="logo" href={home || "#"}>
          <Logo variant="full" height={72} onPanel />
        </a>
        <address>
          {SITE.address.street}<br>
          {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}<br>
          <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
      </div>

      <div>
        <h5>Hiring</h5>
        <ul>
          <li><a href={url("/find-talent/")}>Hiring Solutions</a></li>
          <li><a href={url("/find-talent/")}>Executive Recruiting</a></li>
          <li><a href={url("/find-talent/#collaborative")}>Collaborative Search<sup>®</sup></a></li>
          <li><a href={url("/find-talent/#why")}>Candidate Assessment</a></li>
          <li><a href={`${home}#vetting`}>Private Vetting</a></li>
          <li><a href={url("/find-talent/#evaluation")}>Interviewing</a></li>
        </ul>
      </div>

      <div>
        <h5>Career</h5>
        <ul>
          <li><a href={`${home}#career`}>Career Solutions</a></li>
          <li><a href={`${home}#career`}>Career Assessment</a></li>
          <li><a href={`${home}#career`}>Executive Career Strategy</a></li>
          <li><a href={`${home}#career`}>Interview Preparation</a></li>
          <li><a href={`${home}#jobs`}>Current Jobs</a></li>
          <li><a href={`${home}#jobs`}>Submit Resume</a></li>
        </ul>
      </div>

      <div>
        <h5>Company</h5>
        <ul>
          <li><a href={`${home}#michael`}>About</a></li>
          <li><a href={`${home}#michael`}>Michael Schlager</a></li>
          <li><a href={`${home}#story`}>Success Stories</a></li>
          <li><a href={`${home}#insights`}>Insights</a></li>
          <li><a href="#">Industries</a></li>
          <li><a href={`${home}#close`}>Contact</a></li>
        </ul>
      </div>

      <div>
        <h5>Locations</h5>
        <ul>
          {SITE.areaServed.map((area) => (
            <li><a href="#">{area}</a></li>
          ))}
        </ul>
        <p class="ftr-related">
          Business consulting, leadership coaching, or HR support?
          <a href={SITE.relatedCompany.url}>{SITE.relatedCompany.name}</a>
        </p>
      </div>
    </div>

    <div class="ftr-bot">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <span>Executive recruiting and career solutions · New Jersey and beyond</span>
    </div>
  </div>
</footer>
