---
import { SITE } from "../data/site";
import Logo from "./Logo.astro";
---

<footer class="ftr">
  <div class="wrap ftr-in">
    <div class="ftr-top">
      <div class="ftr-brand">
        <a class="logo" href="#">
          <Logo variant="full" height={72} onPanel />
        </a>
        <address>
          {SITE.address.street}<br>
          {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}<br>
          <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a><br>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
      </div>

      <div>
        <h5>Hiring</h5>
        <ul>
          <li><a href="#hiring">Hiring Solutions</a></li>
          <li><a href="#hiring">Executive Recruiting</a></li>
          <li><a href="#collaborative">Collaborative Search<sup>®</sup></a></li>
          <li><a href="#hiring">Candidate Assessment</a></li>
          <li><a href="#vetting">Private Vetting</a></li>
          <li><a href="#forensic">Interviewing</a></li>
        </ul>
      </div>

      <div>
        <h5>Career</h5>
        <ul>
          <li><a href="#career">Career Solutions</a></li>
          <li><a href="#career">Career Assessment</a></li>
          <li><a href="#career">Executive Career Strategy</a></li>
          <li><a href="#career">Interview Preparation</a></li>
          <li><a href="#jobs">Current Jobs</a></li>
          <li><a href="#jobs">Submit Resume</a></li>
        </ul>
      </div>

      <div>
        <h5>Company</h5>
        <ul>
          <li><a href="#michael">About</a></li>
          <li><a href="#michael">Michael Schlager</a></li>
          <li><a href="#story">Success Stories</a></li>
          <li><a href="#insights">Insights</a></li>
          <li><a href="#">Industries</a></li>
          <li><a href="#close">Contact</a></li>
        </ul>
      </div>

      <div>
        <h5>Locations</h5>
        <ul>
          {SITE.areaServed.map((area) => (
            <li><a href="#">{area}</a></li>
          ))}
        </ul>
        <p class="ftr-related">
          Business consulting, leadership coaching, or HR support?
          <a href={SITE.relatedCompany.url}>{SITE.relatedCompany.name}</a>
        </p>
      </div>
    </div>

    <div class="ftr-bot">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <span>Executive recruiting and career solutions · New Jersey and beyond</span>
    </div>
  </div>
</footer>
