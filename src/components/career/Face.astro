---
import { Image } from "astro:assets";

/*
 * The small round portrait Michael asked for — "almost like a Facebook
 * thing, a little round picture of a face in the upper right-hand corner".
 *
 * The ten portraits are in src/assets/people/. This still renders the
 * initial when a file is missing rather than a broken image or a grey box,
 * so a renamed or dropped file degrades quietly rather than erroring. The
 * keys are adam, marcus, priya, rachel, dana, omar, david, elaine, ray and
 * nicole; add src/assets/people/<key>.png and it appears, nothing else.
 *
 * import.meta.glob is eager so Astro can process each one at build time;
 * a key with no file simply resolves to undefined.
 */
interface Props {
  /** Matches the file name in src/assets/people/. */
  who: string;
  name: string;
  size?: number;
}
const { who, name, size = 44 } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/people/*.{png,jpg,jpeg,webp}",
  { eager: true },
);
const found = files[`../../assets/people/${who}.png`]
  ?? files[`../../assets/people/${who}.webp`]
  ?? files[`../../assets/people/${who}.jpg`]
  ?? files[`../../assets/people/${who}.jpeg`];
---

{found ? (
  <Image
    class="face"
    src={found.default}
    alt=""
    width={size * 2}
    height={size * 2}
    style={`--face:${size}px`}
    loading="lazy"
  />
) : (
  /* Placeholder. Decorative either way — the name is right beside it in
     real text, so neither state needs to be announced. */
  <span class="face face--wait" style={`--face:${size}px`} aria-hidden="true">
    {name.slice(0, 1)}
  </span>
)}
