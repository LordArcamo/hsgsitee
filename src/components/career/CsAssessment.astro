---
import { SELF_CHECK } from "../../data/career-continuum";
import Icon from "../Icon.astro";

/*
 * "Where Are You Right Now?" — rebuilt from Michael's call.
 *
 * WHY THIS IS NOT A WIZARD ANY MORE
 *
 * It was five steps, one question per screen, Back and Continue. Michael's
 * complaints were that there is too much space between options, that the
 * rows should be thinner "so when it's on mobile they can see more at once
 * and check it off", and that it is not clear "whether they're making a
 * choice or following a path".
 *
 * That last one is the wizard's own fault. A numbered rail with Continue
 * buttons reads as a path. A sheet you tick reads as a choice. So: one
 * sheet, nine questions, chips instead of cards, one action at the end.
 *
 * WHY REAL INPUTS
 *
 * Every chip is a visually hidden radio or checkbox inside its label. A
 * native group gives arrow keys, roving focus, the "2 of 4" announcement
 * and form semantics for free. It also means the thing on screen and the
 * thing a form would submit cannot drift apart — they are the same thing.
 *
 * WHY data-q
 *
 * The continuum prefills an answer when you open one of its stories. It
 * used to find the question by position, which breaks the moment a
 * question moves. It now looks up data-q by the question's stable id.
 *
 * WHAT HAPPENS ON SUBMIT
 *
 * Nothing posts anywhere, because nothing on this site posts anywhere yet.
 * Michael's actual ask — "if the summary comes to me in the email, I know
 * a much better way to start" — needs a backend that does not exist. So
 * the button builds the summary and hands it to the visitor's mail app,
 * which lets him read the exact email he would receive. Lord replaces this
 * with a POST by setting data-wn-endpoint; the script prefers it when set.
 */
const S = SELF_CHECK;

/* Questions are numbered 01-09 across both groups, not restarted per group:
   nine is the number a visitor is being asked to get through. */
const OFFSET = S.groups.map((_, i) => S.groups.slice(0, i).reduce((n, p) => n + p.questions.length, 0));
const NUM = (gi: number, qi: number) => OFFSET[gi] + qi + 1;
---

<section class="sec sec--soft wn-sec" id="where-now">
  <div class="wrap">
    <div class="wn-head rv">
      <p class="wn-eyebrow">{S.eyebrow}</p>
      <h2>{S.title}</h2>
      <p class="wn-lede">{S.lede}</p>
    </div>

    <form
      class="wn-sheet rv"
      style="--d:1"
      data-wn
      data-wn-endpoint=""
      data-wn-mail={`mailto:?subject=${encodeURIComponent(S.send.subject)}`}
      novalidate
    >
      {/* Michael: "tell people what to do — choose what applies to you",
          with arrows. The arrow points at the first group, not decoration. */}
      <p class="wn-instruct">
        <span class="wn-instruct-t">{S.instruction}</span>
        <span class="wn-instruct-s">{S.instructionSub}</span>
        <span class="wn-arrow" aria-hidden="true">↓</span>
      </p>

      <p class="wn-micro">
        <span class="wn-micro-ic" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.5.4.8 1 .9 1.6h5.2c.1-.6.4-1.2.9-1.6A6 6 0 0 0 12 3Z"/></svg>
        </span>
        {S.micro}
      </p>

      {S.groups.map((g, gi) => (
        <div class="wn-group" data-draft={g.draft ? "" : undefined}>
          <p class="wn-group-l">
            <span>{g.label}</span>
            {g.draft && <span class="wn-draft" title={S.draftNote}>Draft</span>}
          </p>

          {g.questions.map((q, qi) => (
            <fieldset class="wn-q" data-q={q.id} data-pick={q.pick}>
              <legend class="wn-q-head">
                {/* The number and the tick sit inside the head row, so the
                    structure they add costs no height. */}
                <span class="wn-q-n" aria-hidden="true">{String(NUM(gi, qi)).padStart(2, "0")}</span>
                <span class="wn-q-body">
                  <span class="wn-q-t">{q.q}</span>
                  <span class="wn-q-hint">{q.pick === "one" ? S.pickOne : S.pickAny}</span>
                  <span class="wn-q-ok" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
                  </span>
                </span>
              </legend>

              <div class="wn-chips">
                {q.options.map((o) => (
                  <label class="wn-chip">
                    <input
                      type={q.pick === "one" ? "radio" : "checkbox"}
                      name={q.id}
                      value={o.value}
                      data-desc={o.desc}
                    />
                    <span class="wn-chip-ic" aria-hidden="true"><Icon name={o.icon} size={15} /></span>
                    <span class="wn-chip-t">{o.value}</span>
                  </label>
                ))}
              </div>

              {/* Question 1's descriptions are real copy from the spec, but
                  they will not fit in a chip. They appear here once that
                  chip is chosen, so the row stays thin and nothing is lost. */}
              <p class="wn-echo" data-wn-echo hidden></p>
            </fieldset>
          ))}
        </div>
      ))}

      {/* His question, verbatim, and the reason the whole thing exists:
          "if they don't write something, I don't know who they are." */}
      <div class="wn-why" data-wn-why hidden>
        <label class="wn-why-q" for="wn-why-text">{S.why.q}</label>
        <p class="wn-why-hint">{S.why.hint}</p>
        <textarea id="wn-why-text" name="why" rows="4" placeholder={S.why.placeholder}></textarea>
      </div>

      <div class="wn-out" data-wn-out hidden>
        <p class="wn-out-l">{S.recap.title}</p>
        <ul class="wn-out-list" data-wn-list></ul>
      </div>

      {/* Appears once something is answered and hides again when the real
          action block scrolls into view, so there are never two live Send
          buttons on screen at the same time. */}
      <div class="wn-bar" data-wn-bar hidden>
        <div class="wn-bar-in">
          <p class="wn-bar-count">
            <span data-wn-done>0</span> of {S.groups.reduce((n, g) => n + g.questions.length, 0)} answered
          </p>
          <span class="wn-bar-track" aria-hidden="true"><span class="wn-bar-fill" data-wn-fill></span></span>
          <button class="btn wn-bar-send" type="submit">
            {S.send.label} <span class="arrow" aria-hidden="true">→</span>
          </button>
        </div>
      </div>

      <div class="wn-act" data-wn-act>
        <button class="btn wn-send" type="submit" data-wn-send disabled>
          {S.send.label} <span class="arrow" aria-hidden="true">→</span>
        </button>
        <button class="wn-clear" type="button" data-wn-clear hidden>{S.clear}</button>
        <p class="wn-act-note">{S.send.note}</p>
      </div>

      {/* A same-page anchor, so NOT wrapped in url(): that helper adds the
          Pages base prefix and turned #talk into /#talk, which points at
          the homepage. */}
      <a class="wn-talk" href={S.final.href}>{S.final.label} <span class="arrow" aria-hidden="true">→</span></a>
    </form>
  </div>
</section>

<script>
  import { initAssessment } from "../../scripts/assessment";
  initAssessment();
</script>
