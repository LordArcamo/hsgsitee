---
import { SECTION, DISCLAIMER, STORIES, NICOLE } from "../../data/career-continuum";
import Face from "./Face.astro";

/*
 * The career-needs continuum: Adam, Rachel, David on one flat line, and
 * Nicole beside it.
 *
 * WHY NICOLE IS NOT A TAB
 *
 * The handoff says twice that she must not read as the expensive end of the
 * line — her problem was access and advocacy, and the engagement cost the
 * candidate nothing. A fourth marker on the rail would say the opposite
 * whatever the copy underneath it said. So she is a card of her own, always
 * open, visually detached: on a wide screen beside the rail, on a phone
 * immediately after Adam → Rachel → David, which is exactly the order the
 * handoff's note 3 asks for.
 *
 * WHY THE LINE IS FLAT
 *
 * /find-talent/ has a rail that descends, because a client's problem gets
 * deeper. This one is a range of different problems, not deeper ones, so
 * the three markers are identical and level. The two sections are siblings
 * and should not be the same drawing.
 *
 * Colour: Adam → Rachel → David run one gold ramp, light to deep, and
 * Nicole is brand purple. The handoff colours them blue, green and orange —
 * but green means Hiring everywhere else on this site, so a green marker on
 * the career page would read as the wrong practice. Say the word and I will
 * switch to the handoff's four.
 */
---

<section class="sec sec--soft csc" id="continuum">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-career">{SECTION.eyebrow}</p>
      <h2>{SECTION.title}</h2>
      <p class="lede">{SECTION.lede}</p>
      <p class="csc-intro">{SECTION.intro}</p>
    </div>

    <p class="csc-disc rv" style="--d:1">{DISCLAIMER}</p>

    <div class="csc-grid rv" style="--d:1" data-cc>
      <div class="csc-main">
        <p class="csc-rail-l">{SECTION.railLabel}</p>

        {/* Three columns, three people each. The lead carries the real case
            study; the two under it are recognition examples with no outcome
            and no figure. All nine are selectable — Michael wanted people
            able to "move the little thing" and find the description that
            sounds like them, and the two extra lines are there so more
            people find one. */}
        <div class="csc-rail" role="tablist" aria-label={SECTION.railLabel}>
          {STORIES.map((s, i) => (
            <div class="csc-col" style={`--i:${i}`} data-col={i}>
              <button
                class="csc-marker"
                role="tab"
                id={`csc-tab-${s.key}`}
                aria-controls={`csc-panel-${s.key}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-prefill={s.prefill === undefined ? undefined : `blocker:${s.prefill}`}
                data-col-of={i}
                type="button"
              >
                {/* Upper right, as Michael asked. */}
                <span class="csc-face"><Face who={s.key} name={s.name} size={48} /></span>
                <span class="csc-name">{s.name}</span>
                <span class="csc-said">&ldquo;{s.said}&rdquo;</span>
                <span class="csc-dot" aria-hidden="true"></span>
                <span class="csc-tag">{s.tagline}</span>
              </button>

              {s.examples && (
                <div class="csc-also">
                  <p class="csc-also-l">Or any of these</p>
                  {s.examples.map((e) => (
                    <button
                      class="csc-row"
                      role="tab"
                      id={`csc-tab-${e.key}`}
                      aria-controls={`csc-panel-${e.key}`}
                      aria-selected="false"
                      tabindex={-1}
                      data-prefill={e.prefill === undefined ? undefined : `blocker:${e.prefill}`}
                      data-col-of={i}
                      type="button"
                    >
                      <span class="csc-row-face"><Face who={e.key} name={e.name} size={28} /></span>
                      <span class="csc-row-said">&ldquo;{e.said}&rdquo;</span>
                    </button>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>

        {/* One panel per person. The caret under the panel slides to sit
            below whichever column is live — Michael asked for "a line from
            the top... to let people know this is Adam down here". */}
        {STORIES.flatMap((s, i) => [
          <div
            class="csc-panel"
            id={`csc-panel-${s.key}`}
            role="tabpanel"
            aria-labelledby={`csc-tab-${s.key}`}
            data-of-col={i}
            hidden={i !== 0}
          >
            <p class="csc-panel-t">{s.name} &mdash; {s.tagline}</p>
            <p class="csc-body">{s.body}</p>
            <ul class="csc-work">
              {s.work.map((w) => <li>{w}</li>)}
            </ul>
            <p class="csc-inv">
              <span>{s.investment.label}</span>
              <b>{s.investment.value}</b>
            </p>
          </div>,
          ...(s.examples ?? []).map((e) => (
            <div
              class="csc-panel csc-panel--ex"
              id={`csc-panel-${e.key}`}
              role="tabpanel"
              aria-labelledby={`csc-tab-${e.key}`}
              data-of-col={i}
              hidden
            >
              <p class="csc-panel-t">{e.name} &mdash; {e.tagline}</p>
              <p class="csc-body">{e.body}</p>
              <ul class="csc-work">
                {e.work.map((w) => <li>{w}</li>)}
              </ul>
              {/* No investment line. These are situations, not engagements. */}
              <p class="csc-ex-note">An example of the kind of situation {STORIES[i].name}&rsquo;s work started from.</p>
            </div>
          )),
        ])}
      </div>

      <!-- Nicole: off the line, always open. -->
      <aside class="csc-nicole">
        <span class="csc-face csc-face--n"><Face who={NICOLE.key} name={NICOLE.name} size={48} /></span>
        <p class="csc-kicker">{NICOLE.kicker}</p>
        <p class="csc-name csc-name--n">{NICOLE.name}</p>
        <p class="csc-said csc-said--n">&ldquo;{NICOLE.said}&rdquo;</p>
        <p class="csc-note">{NICOLE.note}</p>
        <p class="csc-body">{NICOLE.body}</p>
        <ul class="csc-work">
          {NICOLE.work.map((w) => <li>{w}</li>)}
        </ul>
        <p class="csc-inv csc-inv--n">
          <span>{NICOLE.investment.label}</span>
          <b>{NICOLE.investment.value}</b>
        </p>
      </aside>
    </div>

  </div>
</section>

<script>
  import { initContinuum } from "../../scripts/continuum";
  initContinuum();
</script>
