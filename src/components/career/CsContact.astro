---
import { CONTACT } from "../../data/career";
import { SITE } from "../../data/site";
import CandidateIntake from "../CandidateIntake.astro";

/*
 * 12 Final CTA. The same professionals intake the audience bar opens, so
 * there is one way to start a conversation rather than three — and beside
 * it the two job-board actions, which are what most visitors came for and
 * should not have to scroll back up to find.
 */
---

<section class="sec cs-contact" id="talk">
  <div class="wrap cs-contact-grid">
    <div class="cs-contact-copy rv">
      <p class="eyebrow is-career">{CONTACT.eyebrow}</p>
      <h2>{CONTACT.title}</h2>
      <p class="lede">{CONTACT.lede}</p>

      <div class="cs-jobs">
        {CONTACT.actions.map((a) => (
          <a class="cs-job" href={a.href}>
            {a.label} <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <a class="cs-phone" href={`tel:${SITE.phoneHref}`}>
        <span class="cs-phone-ic" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        </span>
        <span><small>Phone</small>{SITE.phone}</span>
      </a>
    </div>

    <div class="cs-intake rv" style="--d:1" data-aud-inline>
      <CandidateIntake title={CONTACT.conversation.label} />
    </div>
  </div>
</section>

<script>
  import { initInlineIntakes } from "../../scripts/audience-menu";
  initInlineIntakes();
</script>
