---
import Logo from "./Logo.astro";
import { SITE } from "../data/site";
import { url } from "../lib/url";

interface Props {
  /**
   * Prefix for the in-page anchors. Empty on the homepage, where every link
   * here is a same-page jump; "/" on any other page, so the links travel
   * home first and still land on the right section.
   */
  home?: string;
}

const { home = "" } = Astro.props;

/*
 * Four things at the top level, one call to action. The site is built around
 * two service lines, so the nav is too: Hiring and Careers each get a small
 * menu of their sections — the same two headings the footer uses — Insights
 * stands alone, and About gathers the founder and the ways to get in touch.
 * The audience bar beneath the header already says "For Companies" and
 * "For Professionals"; these menus deliberately use different words so the
 * two rows do not read as one repeated menu. "Industries" is left out until
 * it has a page — a link to "#" scrolls to the top and reads as broken.
 */
const menus = [
  {
    id: "hiring",
    label: "Hiring",
    items: [
      { href: url("/find-talent/"), label: "Hiring Solutions" },
      { href: url("/find-talent/#collaborative"), label: "Collaborative Search®" },
      { href: `${home}#story`, label: "Success Stories" },
    ],
  },
  {
    id: "careers",
    label: "Careers",
    items: [
      { href: `${home}#career`, label: "Career Solutions" },
      { href: `${home}#jobs`, label: "Current Jobs" },
    ],
  },
] as const;

const about = {
  id: "about",
  label: "About",
  items: [
    { href: `${home}#michael`, label: "Meet Michael" },
    { href: `${home}#close`, label: "Contact" },
  ],
} as const;

const insights = { href: `${home}#insights`, label: "Insights" };
---

<header class="hdr" id="hdr">
  <div class="hdr-in">
    <a class="logo" href={home || "#"}>
      <Logo height={44} />
    </a>

    <nav class="nav" aria-label="Primary">
      {[...menus, about].map((m, i) => (
        <>
          {i === menus.length && (
            <a class="nav-link" href={insights.href}>{insights.label}</a>
          )}
          <div class:list={["nav-item", `is-${m.id}`]} data-nav-menu>
            <button
              class="nav-trigger"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls={`nav-menu-${m.id}`}
            >
              {m.label}
              <svg class="nav-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-menu" id={`nav-menu-${m.id}`} hidden>
              {m.items.map((it) => (
                <a href={it.href}>{it.label}</a>
              ))}
            </div>
          </div>
        </>
      ))}
    </nav>

    <div class="hdr-cta">
      <a class="btn btn--ghost hdr-phone" href={`tel:${SITE.phoneHref}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6.2 6.2l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        <span>{SITE.phone}</span>
      </a>
      <a class="btn" href={url("/find-talent/")}>Find Talent</a>
      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobilenav" aria-label="Open menu">
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- The same groups, laid flat: on a phone a heading per group reads more
       cleanly than nested accordions. -->
  <div class="mobile-nav" id="mobilenav">
    {menus.map((m) => (
      <div class:list={["m-group", `is-${m.id}`]}>
        <p class="m-heading">{m.label}</p>
        <ul>
          {m.items.map((it) => (
            <li><a href={it.href}>{it.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
    <div class="m-group">
      <ul>
        <li><a href={insights.href}>{insights.label}</a></li>
      </ul>
    </div>
    <div class="m-group">
      <p class="m-heading">{about.label}</p>
      <ul>
        {about.items.map((it) => (
          <li><a href={it.href}>{it.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="m-actions">
      <a class="btn" href={url("/find-talent/")}>Find Talent</a>
      <a class="btn btn--ghost" href={`tel:${SITE.phoneHref}`}>Call {SITE.phone}</a>
    </div>
  </div>
</header>

<script>
  import { initHeader } from "../scripts/header";
  initHeader();
</script>
