---
import Logo from "./Logo.astro";
---

<header class="hdr" id="hdr">
  <div class="hdr-in">
    <a class="logo" href="#">
      <Logo height={44} />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="#hiring">Hiring Solutions</a>
      <a href="#career">Career Solutions</a>
      <a href="#jobs">Jobs</a>
      <a href="#">Industries</a>
      <a href="#story">Success Stories</a>
      <a href="#insights">Insights</a>
      <a href="#michael">About</a>
      <a href="#close">Contact</a>
    </nav>

    <div class="hdr-cta">
      <a class="btn btn--ghost" href="#jobs">Find a Job</a>
      <a class="btn" href="#close">Find Talent</a>
      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobilenav" aria-label="Open menu">
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobilenav">
    <ul>
      <li><a href="#hiring">Hiring Solutions</a></li>
      <li><a href="#career">Career Solutions</a></li>
      <li><a href="#jobs">Jobs</a></li>
      <li><a href="#">Industries</a></li>
      <li><a href="#story">Success Stories</a></li>
      <li><a href="#insights">Insights</a></li>
      <li><a href="#michael">About</a></li>
      <li><a href="#close">Contact</a></li>
    </ul>
    <div class="m-actions">
      <a class="btn" href="#close">Find Talent</a>
      <a class="btn btn--ghost" href="#jobs">Find a Job</a>
    </div>
  </div>
</header>

<script>
  import { initHeader } from "../scripts/header";
  initHeader();
</script>
