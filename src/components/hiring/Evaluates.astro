---
import { EVALUATES } from "../../data/hiring";
import Icon from "./Icon.astro";

/*
 * 05 What Collaborative Search® evaluates — the spec's five cards, which are
 * the live page's five method steps, laid out as one numbered sequence.
 * Kept short on purpose: 04 and 09 carry the detail.
 */
---

<section class="sec" id="evaluates">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-hire">Inside the Search</p>
      <h2>What Collaborative Search<sup>®</sup> Evaluates</h2>
    </div>

    <ol class="ev-row">
      {EVALUATES.map((c, i) => (
        <li class="ev-step rv" style={`--d:${i + 1}`}>
          <span class="ev-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="ev-ic"><Icon name={c.icon} /></span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
