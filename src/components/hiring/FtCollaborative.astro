---
import { COLLAB_STAGES, INVOLVEMENT } from "../../data/hiring";

/*
 * 04 Collaborative Search® — the seven stages as a vertical list beside a
 * detail panel (the homepage shows them as a horizontal row of dots), then
 * the live page's most distinctive promise: HSG is as involved as the
 * client wants.
 *
 * WAI-ARIA tabs, vertical: arrow keys, Home and End move between stages
 * (hiring.ts). Every panel is in the HTML and visible until the script
 * runs, so without it the section reads as a numbered list.
 */
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(COLLAB_STAGES.length);
---

<section class="sec sec--soft" id="collaborative">
  <div class="wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-hire">The HSG Approach</p>
      <h2>Collaborative Search<sup>®</sup></h2>
      <p class="cs-sub">Understand the company before searching for the candidate.</p>
    </div>

    <div class="csv rv" style="--d:1" data-cs>
      <div class="csv-list" role="tablist" aria-orientation="vertical" aria-label="Collaborative Search stages">
        {COLLAB_STAGES.map((st, i) => (
          <button
            class="csv-tab"
            type="button"
            role="tab"
            id={`cs-tab-${st.key}`}
            aria-controls={`cs-panel-${st.key}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="csv-dot" aria-hidden="true"></span>
            <span class="csv-n">{pad(i + 1)}</span>
            <span class="csv-name">{st.name}</span>
          </button>
        ))}
      </div>

      <div class="csv-panels">
        {COLLAB_STAGES.map((st, i) => (
          <div
            class="csv-panel"
            role="tabpanel"
            id={`cs-panel-${st.key}`}
            aria-labelledby={`cs-tab-${st.key}`}
            tabindex="0"
          >
            <span class="csv-big" aria-hidden="true">{pad(i + 1)}</span>
            <p class="csv-count">Stage {pad(i + 1)} of {total}</p>
            <h3>{st.name}</h3>
            <p>{st.detail}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="inv rv" style="--d:2">
      <blockquote class="inv-quote">
        <p>{INVOLVEMENT.quote}</p>
      </blockquote>
      <div class="inv-body">
        <p class="inv-lead">{INVOLVEMENT.lead}</p>
        <ul class="inv-opts">
          {INVOLVEMENT.options.map((o) => (
            <li><b>{o.title}</b><span>{o.body}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
