---
import { BENEFITS } from "../../data/hiring";
import Icon from "../Icon.astro";

/* 06 Why companies choose HSG — six benefits as an open two-column list
   rather than the homepage's boxed capability cards. */
---

<section class="sec sec--soft" id="why">
  <div class="wrap why-layout">
    <div class="sec-head rv">
      <p class="eyebrow is-hire">Why HSG</p>
      <h2>Why Companies Choose HSG</h2>
    </div>

    <ul class="why-list">
      {BENEFITS.map((b, i) => (
        <li class="why-item rv" style={`--d:${(i % 2) + 1}`}>
          <span class="why-ic"><Icon name={b.icon} /></span>
          <div>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
