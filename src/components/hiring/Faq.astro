---
import { FAQS } from "../../data/hiring";
import { sup } from "../../lib/text";
import { url } from "../../lib/url";

/*
 * 12 FAQ — native <details>, so it opens and closes with no script and is
 * keyboard- and screen-reader-accessible for free.
 *
 * Every answer is published copy — the live page's ten, plus two answered
 * from the homepage — so the page emits FAQPage structured data from this
 * same list (the page's schema prop), as the live page does today.
 */
---

<section class="sec sec--soft" id="faq">
  <div class="wrap faq-wrap">
    <div class="sec-head rv">
      <p class="eyebrow is-hire">Questions About Executive Search?</p>
      <h2>What Companies Ask Us</h2>
    </div>

    <div class="faq rv" style="--d:1">
      {FAQS.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span set:html={sup(f.q)} />
            <span class="faq-ic" aria-hidden="true"></span>
          </summary>
          <p set:html={sup(f.a)} />
        </details>
      ))}

      {/* These twelve answer what executive search is. The ten on the other
          page answer what a sceptical owner actually wants to know before
          handing a recruiter a hire, at length and in Michael's voice. */}
      <a class="faq-more" href={url("/questions-to-ask-an-executive-recruiter/")}>
        Ten harder questions worth asking before you hire any recruiter
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
